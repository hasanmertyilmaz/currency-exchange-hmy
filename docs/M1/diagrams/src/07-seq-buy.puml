@startuml seq-buy
' DF-2: Data-changing action — buy currency with a stable operation identity
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign left
autonumber

actor User
participant "Exchange screen" as UI
participant "TransactionRepository" as Repo
database "OperationJournal" as Journal
participant "ApiClient" as Api
participant "Web service" as WS
database "PostgreSQL" as DB

User -> UI : enter 100.00 EUR, tap "Review"
UI --> User : confirmation (ask rate, PLN cost, NBP table no)
User -> UI : tap "Confirm"
UI -> Repo : exchange(BUY, EUR, 100.00, tableNo)
Repo -> Repo : operationId = UUIDv4 (generated once)
Repo -> Journal : add(operationId, payload, SENDING)
Repo -> Api : POST /api/v1/exchanges\nIdempotency-Key: operationId (timeout 15 s, no auto-retry)
Api -> WS : HTTPS request + JWT
WS -> WS : validate JWT, body, amount limits
WS -> DB : BEGIN
WS -> DB : INSERT wallet (user, EUR) ON CONFLICT DO NOTHING
WS -> DB : SELECT wallets PLN, EUR FOR UPDATE\n(ordered by currency_code)
note right of DB
Row locks serialise every data-changing
request of the same user, including a
concurrent duplicate with the same key.
end note
WS -> DB : SELECT operation_record\nWHERE (user_id, operation_id)
alt record exists (duplicate / retry)
  WS -> DB : COMMIT (nothing changed)
  WS --> Api : stored status + body,\nheader Idempotent-Replayed: true
else new operation
  WS -> DB : SELECT latest EUR rate; compare table_no
  alt rate table changed
    WS -> DB : INSERT operation_record (REJECTED, 409)
    WS -> DB : COMMIT
    WS --> Api : 409 RATE_CHANGED (new rate in body)
  else PLN balance >= cost
    WS -> DB : UPDATE wallet PLN -cost, EUR +100.00
    WS -> DB : INSERT exchange_transaction (operation_id)
    WS -> DB : INSERT operation_record (COMPLETED, 201, body)
    WS -> DB : COMMIT
    WS --> Api : 201 Created {transaction, balances}
  else insufficient funds
    WS -> DB : INSERT operation_record (REJECTED, 422)
    WS -> DB : COMMIT (no wallet change)
    WS --> Api : 422 INSUFFICIENT_FUNDS
  end
end
Api --> Repo : result
Repo -> Journal : update(status = COMPLETED or REJECTED)
Repo --> UI : show result from server response
UI --> User : success / rejection message, updated balances
@enduml
